# Copy to .env locally. Never commit .env or real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
BUILD_SHA=local-dev
ROUTES_MODE=demo
# Set to vietmap only after VIETMAP_API_KEY is available server-side.
ROAD_PROVIDER=disabled
# Preview the VIETMAP vector basemap locally; otherwise OpenFreeMap is used.
BASEMAP_PROVIDER=openfreemap
DB_MODE=memory
# Keep false for normal local/CD use; Terraform greenfield bootstrap enables the idempotent schema migration.
DB_MIGRATE_ON_START=false
# Diagnostics are for the protected sandbox only, never public production.
DIAGNOSTICS_ENABLED=false
# DB_MODE=mysql requires these values. Use your own local-only credentials.
MYSQL_HOST=127.0.0.1
# Optional Linux local IPC when WARP owns Docker IP routes:
# MYSQL_SOCKET_PATH=/absolute/path/HanoiTrip/.local/mysql-run/mysqld.sock
MYSQL_PORT=3306
MYSQL_DATABASE=hanoitrip
MYSQL_USER=hanoitrip
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_TLS=false
# Production: MYSQL_TLS=true, optionally MYSQL_CA_FILE=/path/to/trusted-ca.pem
# Azure Key Vault references resolve to environment values outside the code.
GOOGLE_ROUTES_API_KEY=
# Browser key is public, restrict it to your exact domains and Maps JS API.
GOOGLE_MAPS_BROWSER_KEY=
# Server-only Search/Place/Route v4 key. Never expose it in /config or the browser bundle.
VIETMAP_API_KEY=
# Separate Tilemap key for BASEMAP_PROVIDER=vietmap, also kept behind the server proxy.
# The services key only works for tiles if VIETMAP has enabled tile access on it.
VIETMAP_TILEMAP_API_KEY=
