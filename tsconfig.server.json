  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "app",
    "outDir": "dist",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["app/server", "app/shared"]
}
