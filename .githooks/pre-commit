#!/usr/bin/env bash
set -euo pipefail

repo=$(git rev-parse --show-toplevel)
git_common_dir=$(git rev-parse --path-format=absolute --git-common-dir)

docker_args=(
  --rm
  --platform linux/amd64
  --volume "$repo:$repo:ro"
  --workdir "$repo"
)

# A linked worktree stores its Git metadata in the main worktree. Mount that
# metadata at the same absolute path so Gitleaks can resolve the worktree's
# .git file while keeping both mounts read-only.
if [[ "$git_common_dir" != "$repo/.git" ]]; then
  docker_args+=(--volume "$git_common_dir:$git_common_dir:ro")
fi

docker run "${docker_args[@]}" \
  ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:b109bc5f8f76a38196a3e413704fc5b9e3c32360bce4e4b603bd6f45b3721dbb \
  protect --staged --redact=100
